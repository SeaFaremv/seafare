# Copy this file to .env and fill in real values.
# Never commit the real .env file to GitHub.

# --- Database (required) -----------------------------------------------------
# From your Neon project dashboard -> Connection Details. Use the "pooled
# connection" string if Neon offers both.
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# --- Front-end URL (required for PIN/passkey reset links) -------------------
# Your GitHub Pages URL, used to build the links emailed/texted during a
# reset, e.g. https://YOUR-USERNAME.github.io/YOUR-REPO
APP_URL=https://YOUR-USERNAME.github.io/YOUR-REPO

# --- Owner PIN reset via email (optional) ------------------------------------
# A Gmail account the server sends FROM. GMAIL_APP_PASSWORD is an "App
# Password" generated at https://myaccount.google.com/apppasswords -- this
# requires 2-Step Verification to be turned on for that Gmail account first.
# If unset, the reset link is still generated and returned to the app (so the
# Owner can open/share it manually) -- email just won't be auto-sent.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16characterapppassword

# --- Owner PIN reset via SMS (optional) --------------------------------------
# From your Twilio console (twilio.com/console). TWILIO_PHONE_NUMBER is the
# SMS-capable Twilio number the text is sent FROM. Same fallback as above if
# unset -- the link is still returned to the app either way.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --- Owner PIN reset via authenticator app (legacy, optional) ---------------
# Each organization gets its own TOTP secret generated automatically at
# signup -- this env var is only a fallback used by very old reset links
# that predate that and no longer get created. Safe to leave unset.
TOTP_SECRET=

# --- Super Admin dashboard (required to use it) ------------------------------
# Credentials for the Super Admin screen (organization/boat management,
# suspend/delete, boat request approvals). Choose your own values -- these
# are not defaults, there is no fallback.
ADMIN_USERNAME=choose_a_username
ADMIN_PASSWORD=choose_a_strong_password

# --- Google Sheets trip logging (optional) -----------------------------------
# Requires a Google Cloud project with the Sheets API and Drive API enabled,
# and an OAuth 2.0 Client ID (console.cloud.google.com -> APIs & Services ->
# Credentials). GOOGLE_REDIRECT_URI must exactly match a redirect URI
# registered on that Client ID, and should point at this API server, e.g.
# https://your-api-host.onrender.com/api/google/oauth-callback
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=https://your-api-host.onrender.com/api/google/oauth-callback

# --- Port (usually set automatically by your host, e.g. Render) -------------
# PORT=3000
